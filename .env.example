# PostgreSQL. Vercel Postgres, Neon, Supabase, Railway, local Docker 모두 가능.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dym_tech_store?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dym_tech_store?schema=public"

# Vercel Blob 사용 시 필요. Vercel Storage > Blob 연결 후 자동 생성되는 값을 넣으세요.
BLOB_READ_WRITE_TOKEN=""

# 개발 중 로컬 파일 업로드를 쓰려면 local, Vercel Blob을 쓰려면 vercel-blob.
STORAGE_DRIVER="vercel-blob"

# DB가 비어 있을 때 /api/products 호출 시 42개 상품 슬롯 자동 생성. 개발 테스트용입니다.
# 기존 DB에 상품은 있는데 이미지가 비어 있으면 기본 첨부 이미지 구성을 보정합니다.
AUTO_SEED_ON_EMPTY="true"

# 관리자 로그인. 운영에서는 반드시 변경하세요.
# 개발 중 기본 계정은 로그인 API에서 자동 생성/보정됩니다.
ADMIN_EMAIL="admin@dym.test"
ADMIN_PASSWORD="admin1234"
ADMIN_SESSION_SECRET="change-this-secret-at-least-32-chars"

# Vercel에서 수동 seed API를 호출할 때 사용할 토큰.
ADMIN_SETUP_TOKEN="change-this-seed-token"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
